{
  "name": "@simulatorterminator/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "cargo build -p ra-wasm --target wasm32-unknown-unknown --release && wasm-bindgen ../../target/wasm32-unknown-unknown/release/ra_wasm.wasm --target web --out-dir src/engine/wasm",
    "protocol": "cargo test -p ra-api --features ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "smoke": "node e2e/smoke.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/earcut": "3.2.4",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "earcut": "3.2.4",
    "openskp": "1.3.0",
    "rhino3dm": "8.35.0"
  }
}
